[TEMPLATE]
[TEMPLATE]
# ── API ─────────────────────────────────────────────────────────────────
# Required for both local dev and Vercel.
# (Vercel injects PORT and NODE_ENV=production itself — do NOT set them there.
#  Locally the API defaults to PORT=3001 / NODE_ENV=development.)

# PostgreSQL (Neon) — keep sslmode=require; do NOT add channel_binding
# (libpq-only option; Prisma's engine rejects it).
DATABASE_URL=postgresql://<user>:<password>@<host>.neon.tech/<db>?sslmode=require

# JWT — for production generate strong random values, e.g.
#   openssl rand -base64 48
# Never reuse the dev placeholders in production.
JWT_ACCESS_SECRET=change-me-access-secret-32-chars-minimum
JWT_REFRESH_SECRET=change-me-refresh-secret-32-chars-minimum
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS — comma-separated list of web app origins.
#   local:  http://localhost:3000,http://127.0.0.1:3000
#   live:   https://fabriq.vercel.app  (the web app's own URL — never the API's)
WEB_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Optional: deployed web app URL — the API root (/) redirects here (login page
# becomes the default entry). Never point this at the API's own domain
# (fabri-q.vercel.app) or the root becomes a redirect loop.
# WEB_APP_URL=https://fabriq.vercel.app

# ── Document storage ────────────────────────────────────────────────────
# 'local' (default) writes to the local filesystem — dev only; serverless
# filesystems like Vercel are read-only/ephemeral.
# 'cloudinary' stores uploads in Cloudinary as raw (byte-exact) resources —
# required for production uploads to persist.
# STORAGE_DRIVER=cloudinary
# Cloudinary dashboard → Programmable Media → API keys:
# CLOUDINARY_CLOUD_NAME=...
# CLOUDINARY_API_KEY=...
# CLOUDINARY_API_SECRET=...
# Optional folder prefix inside Cloudinary (recommended: one per environment)
# CLOUDINARY_FOLDER=fabriq-documents
# Local-only (driver=local): disk path for uploads; defaults to ./uploads.
# STORAGE_LOCAL_PATH=./uploads
# Downloads always stream through the API (auth-gated) — no public asset
# configuration needed in Cloudinary.

# ── WEB (apps/web) ───────────────────────────────────────────────────────
# Inlined by Next.js AT BUILD TIME — the value present during `next build`
# is what ships to the browser.
#   local:  http://localhost:3001/api/v1
#   live:   https://fabri-q.vercel.app/api/v1
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
