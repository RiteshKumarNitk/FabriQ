# ── API ──────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://neondb_owner:npg_UxiS09RkzoPg@ep-late-grass-azrd2d0k-pooler.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Redis (queue/cache — reserved for Phases 2+)
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-32-chars-minimum
JWT_REFRESH_SECRET=change-me-refresh-secret-32-chars-minimum
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS — the web app origin
WEB_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# File storage (Phase 1 ships the local driver; S3-compatible driver implements the same interface)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=fabriq-documents
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

# ── WEB ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
