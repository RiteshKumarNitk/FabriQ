{
  "name": "fabriq",
  "version": "0.1.0",
  "private": true,
  "description": "FabriQ — Enterprise multi-tenant garment manufacturing management platform",
  "scripts": {
    "dev": "turbo dev",
    "dev:api": "pnpm --filter @fabriq/api dev",
    "dev:web": "pnpm --filter @fabriq/web dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "clean": "turbo clean",
    "db:generate": "pnpm --filter @fabriq/database db:generate",
    "db:migrate": "pnpm --filter @fabriq/database db:migrate",
    "db:push": "pnpm --filter @fabriq/database db:push",
    "db:seed": "pnpm --filter @fabriq/database db:seed",
    "db:studio": "pnpm --filter @fabriq/database db:studio",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@10.34.5+sha512.a4ee05f2f73658255bd6a89859c065a45c28a57daefae2c893a168ee2b73168c37b91e83e57ea67654ad03f03031746430e8bce38e362e042605fb8abc80192e",
  "dependencies": {
    "next": "^14.2.35"
  }
}
