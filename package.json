{
  "name": "fabriq",
  "version": "0.1.0",
  "private": true,
  "description": "FabriQ — Enterprise multi-tenant garment manufacturing management platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "dev:api": "npm run dev -w @fabriq/api",
    "dev:web": "npm run dev -w @fabriq/web",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "clean": "turbo clean",
    "db:generate": "npm run db:generate -w @fabriq/database",
    "db:migrate": "npm run db:migrate -w @fabriq/database",
    "db:push": "npm run db:push -w @fabriq/database",
    "db:seed": "npm run db:seed -w @fabriq/database",
    "db:studio": "npm run db:studio -w @fabriq/database",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "npm@10.9.8",
  "dependencies": {
    "next": "^14.2.35"
  }
}
