datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ══════════════════════════════════════════════════════════════════════════
// PHASE 1 — PLATFORM FOUNDATION
//
// Conventions (see docs/database-schema.md):
//   • Every business record carries the audit columns:
//     createdOn / createdBy / updatedOn / updatedBy / deletedOn / deletedBy /
//     isDeleted / version
//   • Every business record belongs to a Tenant. tenantId is enforced at the
//     application layer by the tenant-scoped Prisma client extension
//     (packages/database/src/client.ts) — queries can never cross tenants.
//   • Soft-delete: rows are archived (isDeleted=true) by services, never
//     physically removed in normal operation.
// ══════════════════════════════════════════════════════════════════════════

// ── Platform ───────────────────────────────────────────────────────────────

model Tenant {
  id          String       @id @default(uuid())
  code        String       @unique
  name        String
  status      TenantStatus @default(ONBOARDING)
  plan        String? // e.g. "growth", "enterprise" — configurable billing tier
  contactName String?
  contactEmail String?
  contactPhone String?
  address     String?
  city        String?
  state       String?
  country     String?
  logoUrl     String?
  settings    Json?
  createdOn   DateTime     @default(now())
  createdBy   String?
  updatedOn   DateTime     @updatedAt
  updatedBy   String?
  deletedOn   DateTime?
  deletedBy   String?
  isDeleted   Boolean      @default(false)
  version     Int          @default(0)

  companies        Company[]
  factories        Factory[]
  warehouses       Warehouse[]
  departments      Department[]
  sections         Section[]
  productionLines  ProductionLine[]
  users            User[]
  roles            Role[]
  refreshTokens    RefreshToken[]
  auditLogs        AuditLog[]
  settingRows      Setting[]
  masterCategories MasterDataCategory[]
  masterItems      MasterDataItem[]
  documents        Document[]
  notifications    Notification[]
  comments         Comment[]
  workflowDefs     WorkflowDefinition[]
  workflowSteps    WorkflowStep[]
  workflowInsts    WorkflowInstance[]
  workflowTasks    WorkflowTask[]

  // Phase 2 — Procurement
  suppliers          Supplier[]
  documentSequences  DocumentSequence[]
  requisitions       PurchaseRequisition[]
  requisitionItems   PurchaseRequisitionItem[]
  purchaseOrders     PurchaseOrder[]
  purchaseOrderItems PurchaseOrderItem[]
  goodsReceipts      GoodsReceiptNote[]
  grnRolls           GrnRoll[]
  inspections        FabricInspection[]
  inspectionDefects  FabricInspectionDefect[]
  warehouseReceipts  WarehouseReceipt[]
  stockTransactions  StockTransaction[]

  // Phase 3 — Cutting Room
  fabricRolls        FabricRoll[]
  fabrics            Fabric[]
  remnants           Remnant[]
  markers            Marker[]
  cutOrders          CutOrder[]
  measurementSessions FabricMeasurement[]
  fabricSegments     FabricSegment[]
  fabricDefects      FabricDefect[]
  rollTransactions   RollTransaction[]
  patternSets        PatternSet[]
  patternPieces      PatternPiece[]
  markerPieces       MarkerPiece[]
  markerRevisions    MarkerRevision[]
  layPlans           LayPlan[]
  cutOperations      CutOperation[]
}

// ── Organization ───────────────────────────────────────────────────────────

model Company {
  id          String       @id @default(uuid())
  tenantId    String
  code        String
  name        String
  gstin       String?
  address     String?
  city        String?
  state       String?
  country     String?
  phone       String?
  email       String?
  status      EntityStatus @default(ACTIVE)
  createdOn   DateTime     @default(now())
  createdBy   String?
  updatedOn   DateTime     @updatedAt
  updatedBy   String?
  deletedOn   DateTime?
  deletedBy   String?
  isDeleted   Boolean      @default(false)
  version     Int          @default(0)

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  factories Factory[]
  warehouses Warehouse[]
  users      User[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, status])
}

model Factory {
  id        String       @id @default(uuid())
  tenantId  String
  companyId String
  code      String
  name      String
  address   String?
  city      String?
  state     String?
  country   String?
  status    EntityStatus @default(ACTIVE)
  createdOn DateTime     @default(now())
  createdBy String?
  updatedOn DateTime     @updatedAt
  updatedBy String?
  deletedOn DateTime?
  deletedBy String?
  isDeleted Boolean      @default(false)
  version   Int          @default(0)

  tenant          Tenant            @relation(fields: [tenantId], references: [id])
  company         Company           @relation(fields: [companyId], references: [id])
  warehouses      Warehouse[]
  departments     Department[]
  productionLines ProductionLine[]
  users           User[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([companyId])
}

model Warehouse {
  id        String        @id @default(uuid())
  tenantId  String
  companyId String
  factoryId String?
  code      String
  name      String
  type      WarehouseType @default(RAW_MATERIAL)
  address   String?
  isActive  Boolean       @default(true)
  createdOn DateTime      @default(now())
  createdBy String?
  updatedOn DateTime      @updatedAt
  updatedBy String?
  deletedOn DateTime?
  deletedBy String?
  isDeleted Boolean       @default(false)
  version   Int           @default(0)

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  company Company @relation(fields: [companyId], references: [id])
  factory Factory? @relation(fields: [factoryId], references: [id])
  warehouseReceipts WarehouseReceipt[]    // Phase 2
  stockTransactions  StockTransaction[]   // Phase 2

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([companyId])
  @@index([factoryId])
}

// Department → Section → ProductionLine forms the production org tree.
model Department {
  id        String       @id @default(uuid())
  tenantId  String
  factoryId String
  code      String
  name      String
  createdOn DateTime     @default(now())
  createdBy String?
  updatedOn DateTime     @updatedAt
  updatedBy String?
  deletedOn DateTime?
  deletedBy String?
  isDeleted Boolean      @default(false)
  version   Int          @default(0)

  tenant          Tenant            @relation(fields: [tenantId], references: [id])
  factory         Factory           @relation(fields: [factoryId], references: [id])
  sections        Section[]
  productionLines ProductionLine[]
  requisitions    PurchaseRequisition[] // Phase 2

  @@unique([tenantId, factoryId, code])
  @@index([tenantId])
  @@index([factoryId])
}

model Section {
  id           String   @id @default(uuid())
  tenantId     String
  departmentId String
  code         String
  name         String
  createdOn    DateTime @default(now())
  createdBy    String?
  updatedOn    DateTime @updatedAt
  updatedBy    String?
  deletedOn    DateTime?
  deletedBy    String?
  isDeleted    Boolean  @default(false)
  version      Int      @default(0)

  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  department Department @relation(fields: [departmentId], references: [id])

  @@unique([tenantId, departmentId, code])
  @@index([tenantId])
  @@index([departmentId])
}

model ProductionLine {
  id           String             @id @default(uuid())
  tenantId     String
  factoryId    String
  departmentId String?
  code         String
  name         String
  capacity     Int? // operators per line — configurable per tenant
  status       ProductionLineStatus @default(ACTIVE)
  createdOn    DateTime            @default(now())
  createdBy    String?
  updatedOn    DateTime            @updatedAt
  updatedBy    String?
  deletedOn    DateTime?
  deletedBy    String?
  isDeleted    Boolean             @default(false)
  version      Int                 @default(0)

  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  factory    Factory     @relation(fields: [factoryId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])

  @@unique([tenantId, factoryId, code])
  @@index([tenantId])
  @@index([factoryId])
}

// ── Identity & Access ──────────────────────────────────────────────────────

model User {
  id                String     @id @default(uuid())
  tenantId          String? // null = platform user (platform admins)
  companyId         String?
  factoryId         String?
  email             String     @unique
  firstName         String
  lastName          String
  phone             String?
  passwordHash      String
  status            UserStatus @default(PENDING)
  isPlatformAdmin   Boolean    @default(false)
  mustChangePassword Boolean   @default(false)
  lastLoginAt       DateTime?
  createdOn         DateTime   @default(now())
  createdBy         String?
  updatedOn         DateTime   @updatedAt
  updatedBy         String?
  deletedOn         DateTime?
  deletedBy         String?
  isDeleted         Boolean    @default(false)
  version           Int        @default(0)

  tenant         Tenant?        @relation(fields: [tenantId], references: [id])
  company        Company?       @relation(fields: [companyId], references: [id])
  factory        Factory?       @relation(fields: [factoryId], references: [id])
  roles          UserRole[]
  refreshTokens  RefreshToken[]
  notifications  Notification[]
  createdComments Comment[]     @relation("CommentAuthor")
  auditLogs      AuditLog[]
  // Phase 2 — Procurement
  requestedRequisitions PurchaseRequisition[] @relation("RequisitionRequester")
  inspections          FabricInspection[]    @relation("FabricInspector")
  // Phase 3 — Cutting Room
  rollMeasurements      FabricMeasurement[]   @relation("RollMeasurer")

  @@index([tenantId])
  @@index([email])
}

model Role {
  id          String   @id @default(uuid())
  tenantId    String? // null = platform-level role (PLATFORM_ADMIN)
  code        String
  name        String
  description String?
  isSystem    Boolean  @default(false)
  createdOn   DateTime @default(now())
  createdBy   String?
  updatedOn   DateTime @updatedAt
  updatedBy   String?
  deletedOn   DateTime?
  deletedBy   String?
  isDeleted   Boolean  @default(false)
  version     Int      @default(0)

  tenant     Tenant?         @relation(fields: [tenantId], references: [id])
  users      UserRole[]
  permissions RolePermission[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model Permission {
  id          String   @id @default(uuid())
  code        String   @unique
  module      String
  name        String
  description String?
  roles       RolePermission[]
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
  @@index([permissionId])
}

model UserRole {
  id     String @id @default(uuid())
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId])
  @@index([roleId])
}

model RefreshToken {
  id             String   @id @default(uuid())
  userId         String
  tenantId       String?
  tokenHash      String   @unique
  expiresAt      DateTime
  revokedAt      DateTime?
  replacedByTokenId String?
  ip             String?
  userAgent      String?
  createdOn      DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id])
  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@index([userId])
  @@index([expiresAt])
}

// ── Audit ──────────────────────────────────────────────────────────────────

model AuditLog {
  id          String     @id @default(uuid())
  tenantId    String?
  companyId   String?
  factoryId   String?
  userId      String?
  action      AuditAction
  module      String
  entityType  String
  entityId    String?
  method      String
  path        String
  requestBody Json?
  statusCode  Int
  ip          String?
  userAgent   String?
  createdOn   DateTime   @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id])
  user   User?   @relation(fields: [userId], references: [id])

  @@index([tenantId, createdOn])
  @@index([entityType, entityId])
  @@index([userId])
}

// ── Configuration ──────────────────────────────────────────────────────────

model Setting {
  id          String       @id @default(uuid())
  tenantId    String?
  key         String
  value       Json
  scope       SettingScope @default(TENANT)
  group       String?
  description String?
  isSystem    Boolean      @default(false)
  createdOn   DateTime     @default(now())
  createdBy   String?
  updatedOn   DateTime     @updatedAt
  updatedBy   String?
  deletedOn   DateTime?
  deletedBy   String?
  isDeleted   Boolean      @default(false)
  version     Int          @default(0)

  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, key])
  @@index([tenantId])
}

model MasterDataCategory {
  id          String   @id @default(uuid())
  tenantId    String
  code        String
  name        String
  description String?
  isSystem    Boolean  @default(false)
  createdOn   DateTime @default(now())
  createdBy   String?
  updatedOn   DateTime @updatedAt
  updatedBy   String?
  deletedOn   DateTime?
  deletedBy   String?
  isDeleted   Boolean  @default(false)
  version     Int      @default(0)

  tenant Tenant               @relation(fields: [tenantId], references: [id])
  items  MasterDataItem[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model MasterDataItem {
  id          String   @id @default(uuid())
  tenantId    String
  categoryId  String
  code        String
  name        String
  attributes  Json?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdOn   DateTime @default(now())
  createdBy   String?
  updatedOn   DateTime @updatedAt
  updatedBy   String?
  deletedOn   DateTime?
  deletedBy   String?
  isDeleted   Boolean  @default(false)
  version     Int      @default(0)

  tenant   Tenant              @relation(fields: [tenantId], references: [id])
  category MasterDataCategory  @relation(fields: [categoryId], references: [id])

  @@unique([tenantId, categoryId, code])
  @@index([tenantId])
  @@index([categoryId])
}

// ── Documents ──────────────────────────────────────────────────────────────

model Document {
  id         String           @id @default(uuid())
  tenantId   String
  companyId  String?
  factoryId  String?
  category   DocumentCategory @default(GENERAL)
  entityType String // polymorphic reference, e.g. "purchase-order", "user"
  entityId   String
  fileName   String
  storageKey String
  mimeType   String
  sizeBytes  Int
  checksum   String?
  uploadedOn DateTime         @default(now())
  uploadedBy String?

  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([entityType, entityId])
}

// ── Notifications ──────────────────────────────────────────────────────────

model Notification {
  id        String           @id @default(uuid())
  tenantId  String?
  userId    String
  type      NotificationType @default(SYSTEM)
  title     String
  body      String?
  link      String?
  isRead    Boolean          @default(false)
  readAt    DateTime?
  createdOn DateTime         @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id])
  user   User    @relation(fields: [userId], references: [id])

  @@index([userId, isRead])
  @@index([tenantId])
}

// ── Comments (entity timeline discussions) ─────────────────────────────────

model Comment {
  id         String   @id @default(uuid())
  tenantId   String?
  entityType String
  entityId   String
  userId     String
  body       String
  parentId   String?
  createdOn  DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id])
  user   User    @relation("CommentAuthor", fields: [userId], references: [id])

  @@index([entityType, entityId, createdOn])
  @@index([tenantId])
}

// ── Workflow framework ─────────────────────────────────────────────────────
// Generic approval/flow engine. Definitions are per-entity-type; instances
// attach to any business record via (entityType, entityId).

model WorkflowDefinition {
  id          String   @id @default(uuid())
  tenantId    String
  code        String
  name        String
  entityType  String
  description String?
  isActive    Boolean  @default(true)
  createdOn   DateTime @default(now())
  createdBy   String?
  updatedOn   DateTime @updatedAt
  updatedBy   String?
  deletedOn   DateTime?
  deletedBy   String?
  isDeleted   Boolean  @default(false)
  version     Int      @default(0)

  tenant    Tenant            @relation(fields: [tenantId], references: [id])
  steps     WorkflowStep[]
  instances WorkflowInstance[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model WorkflowStep {
  id                  String   @id @default(uuid())
  tenantId            String
  workflowDefinitionId String
  stepOrder           Int
  name                String
  isApproval          Boolean  @default(true)
  assigneeRoleCode    String? // role code that must act at this step
  createdOn           DateTime @default(now())
  createdBy           String?
  updatedOn           DateTime @updatedAt
  updatedBy           String?
  deletedOn           DateTime?
  deletedBy           String?
  isDeleted           Boolean  @default(false)
  version             Int      @default(0)

  tenant   Tenant             @relation(fields: [tenantId], references: [id])
  workflow WorkflowDefinition @relation(fields: [workflowDefinitionId], references: [id])
  tasks    WorkflowTask[]

  @@unique([workflowDefinitionId, stepOrder])
  @@index([tenantId])
}

model WorkflowInstance {
  id                  String         @id @default(uuid())
  tenantId            String
  workflowDefinitionId String
  entityType          String
  entityId            String
  status              WorkflowStatus @default(IN_PROGRESS)
  currentStepId       String?
  createdOn           DateTime       @default(now())
  createdBy           String?
  updatedOn           DateTime       @updatedAt
  updatedBy           String?
  deletedOn           DateTime?
  deletedBy           String?
  isDeleted           Boolean        @default(false)
  version             Int            @default(0)

  tenant   Tenant             @relation(fields: [tenantId], references: [id])
  workflow WorkflowDefinition @relation(fields: [workflowDefinitionId], references: [id])
  tasks    WorkflowTask[]

  @@index([tenantId])
  @@index([entityType, entityId])
  @@index([workflowDefinitionId])
}

model WorkflowTask {
  id             String             @id @default(uuid())
  tenantId       String
  workflowInstanceId String
  stepId         String
  assigneeUserId String?
  assigneeRoleCode String?
  status         WorkflowTaskStatus @default(PENDING)
  comment        String?
  actedBy        String?
  actedAt        DateTime?
  createdOn      DateTime           @default(now())

  tenant   Tenant           @relation(fields: [tenantId], references: [id])
  instance WorkflowInstance @relation(fields: [workflowInstanceId], references: [id])
  step     WorkflowStep     @relation(fields: [stepId], references: [id])

  @@index([tenantId, status])
  @@index([assigneeUserId, status])
  @@index([workflowInstanceId])
}

// ══════════════════════════════════════════════════════════════════════════
// PHASE 2 — PROCUREMENT
//
// The complete purchasing lifecycle: Supplier → Purchase Requisition →
// Purchase Order → Goods Receipt Note → Fabric Inspection → Warehouse Receipt.
// Every header carries the standard audit columns; line items are child rows
// replaced transactionally on edit (soft delete applies to headers only).
// Document numbers (PR-2026-0001, …) are generated per tenant by the
// DocumentSequence counter.
// ══════════════════════════════════════════════════════════════════════════

// ── Document numbering ────────────────────────────────────────────────────

model DocumentSequence {
  id         String   @id @default(uuid())
  tenantId   String
  key        String // e.g. "PR-2026"
  prefix     String // e.g. "PR"
  year       Int
  lastNumber Int      @default(0)
  createdOn  DateTime @default(now())
  updatedOn  DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, key])
  @@index([tenantId])
}

// ── Suppliers ─────────────────────────────────────────────────────────────

model Supplier {
  id               String       @id @default(uuid())
  tenantId         String
  code             String
  name             String
  businessName     String?
  gstin            String?
  pan              String?
  contactPerson    String?
  email            String?
  mobile           String?
  officePhone      String?
  website          String?
  billingAddress   String?
  shippingAddress  String?
  country          String?
  state            String?
  city             String?
  pincode          String?
  paymentTerms     String?
  creditDays       Int          @default(0)
  currency         String       @default("INR")
  bankName         String?
  bankAccountNumber String?
  bankIfsc         String?
  bankBranch       String?
  status           EntityStatus @default(ACTIVE)
  notes            String?
  contacts         Json? // [{ name, designation, email, phone, isPrimary }]
  createdOn        DateTime     @default(now())
  createdBy        String?
  updatedOn        DateTime     @updatedAt
  updatedBy        String?
  deletedOn        DateTime?
  deletedBy        String?
  isDeleted        Boolean      @default(false)
  version          Int          @default(0)

  tenant         Tenant           @relation(fields: [tenantId], references: [id])
  purchaseOrders PurchaseOrder[]
  goodsReceipts  GoodsReceiptNote[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, status])
}

// ── Purchase Requisition ──────────────────────────────────────────────────

model PurchaseRequisition {
  id            String            @id @default(uuid())
  tenantId      String
  number        String
  requestDate   DateTime          @default(now())
  requestedById String?
  departmentId  String?
  priority      Priority          @default(MEDIUM)
  expectedDate  DateTime?
  status        RequisitionStatus @default(DRAFT)
  remarks       String?
  createdOn     DateTime          @default(now())
  createdBy     String?
  updatedOn     DateTime          @updatedAt
  updatedBy     String?
  deletedOn     DateTime?
  deletedBy     String?
  isDeleted     Boolean           @default(false)
  version       Int               @default(0)

  tenant         Tenant?                    @relation(fields: [tenantId], references: [id])
  requestedBy    User?                      @relation("RequisitionRequester", fields: [requestedById], references: [id])
  department     Department?                @relation(fields: [departmentId], references: [id])
  items          PurchaseRequisitionItem[]
  purchaseOrders PurchaseOrder[]

  @@unique([tenantId, number])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, requestDate])
}

model PurchaseRequisitionItem {
  id            String   @id @default(uuid())
  tenantId      String
  requisitionId String
  itemName      String
  description   String?
  quantity      Decimal  @db.Decimal(12, 3)
  unit          Unit     @default(METERS)
  remarks       String?
  createdOn     DateTime @default(now())

  tenant          Tenant                   @relation(fields: [tenantId], references: [id])
  requisition     PurchaseRequisition     @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  purchaseOrders  PurchaseOrderItem[]

  @@index([tenantId])
  @@index([requisitionId])
}

// ── Purchase Order ────────────────────────────────────────────────────────

model PurchaseOrder {
  id              String              @id @default(uuid())
  tenantId        String
  number          String
  supplierId      String
  requisitionId   String?
  poDate          DateTime            @default(now())
  deliveryDate    DateTime?
  currency        String              @default("INR")
  paymentTerms    String?
  deliveryTerms   String?
  taxPercent      Decimal             @default(0) @db.Decimal(6, 2)
  discountPercent Decimal             @default(0) @db.Decimal(6, 2)
  subTotal        Decimal             @default(0) @db.Decimal(14, 2)
  discountAmount  Decimal             @default(0) @db.Decimal(14, 2)
  taxAmount       Decimal             @default(0) @db.Decimal(14, 2)
  totalAmount     Decimal             @default(0) @db.Decimal(14, 2)
  status          PurchaseOrderStatus @default(DRAFT)
  notes           String?
  createdOn       DateTime            @default(now())
  createdBy       String?
  updatedOn       DateTime            @updatedAt
  updatedBy       String?
  deletedOn       DateTime?
  deletedBy       String?
  isDeleted       Boolean             @default(false)
  version         Int                 @default(0)

  tenant      Tenant               @relation(fields: [tenantId], references: [id])
  supplier    Supplier             @relation(fields: [supplierId], references: [id])
  requisition PurchaseRequisition? @relation(fields: [requisitionId], references: [id])
  items       PurchaseOrderItem[]
  receipts    GoodsReceiptNote[]

  @@unique([tenantId, number])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, supplierId])
}

model PurchaseOrderItem {
  id                 String   @id @default(uuid())
  tenantId           String
  purchaseOrderId    String
  requisitionItemId  String?
  itemName           String
  description        String?
  quantity           Decimal  @db.Decimal(12, 3)
  unit               Unit     @default(METERS)
  rate               Decimal  @db.Decimal(14, 2)
  amount             Decimal  @db.Decimal(14, 2)
  gstPercent         Decimal  @default(0) @db.Decimal(6, 2)
  gstAmount          Decimal  @default(0) @db.Decimal(14, 2)
  receivedQty        Decimal  @default(0) @db.Decimal(12, 3)
  createdOn          DateTime @default(now())

  tenant           Tenant                  @relation(fields: [tenantId], references: [id])
  purchaseOrder    PurchaseOrder           @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  requisitionItem  PurchaseRequisitionItem? @relation(fields: [requisitionItemId], references: [id])
  grnRolls         GrnRoll[]

  @@index([tenantId])
  @@index([purchaseOrderId])
}

// ── Goods Receipt Note ────────────────────────────────────────────────────

model GoodsReceiptNote {
  id               String    @id @default(uuid())
  tenantId         String
  number           String
  purchaseOrderId  String
  supplierId       String
  invoiceNumber    String?
  invoiceDate      DateTime?
  vehicleNumber    String?
  receivedDate     DateTime  @default(now())
  status           GrnStatus @default(DRAFT)
  remarks          String?
  createdOn        DateTime  @default(now())
  createdBy        String?
  updatedOn        DateTime  @updatedAt
  updatedBy        String?
  deletedOn        DateTime?
  deletedBy        String?
  isDeleted        Boolean   @default(false)
  version          Int       @default(0)

  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  supplier      Supplier      @relation(fields: [supplierId], references: [id])
  rolls         GrnRoll[]

  @@unique([tenantId, number])
  @@index([tenantId])
  @@index([tenantId, purchaseOrderId])
}

model GrnRoll {
  id                    String       @id @default(uuid())
  tenantId              String
  grnId                 String
  purchaseOrderItemId   String?
  rollNumber            String
  fabricType            String?
  color                 String?
  gsm                   Decimal?     @db.Decimal(6, 2)
  width                 Decimal?     @db.Decimal(8, 2)
  length                Decimal?     @db.Decimal(12, 3)
  weight                Decimal?     @db.Decimal(12, 3)
  batch                 String?
  lot                   String?
  barcode               String?
  qrCode                String?
  condition             RollCondition @default(GOOD)
  status                GrnRollStatus @default(PENDING_INSPECTION)
  remarks               String?
  createdOn             DateTime     @default(now())

  tenant            Tenant               @relation(fields: [tenantId], references: [id])
  grn               GoodsReceiptNote     @relation(fields: [grnId], references: [id], onDelete: Cascade)
  purchaseOrderItem PurchaseOrderItem?   @relation(fields: [purchaseOrderItemId], references: [id])
  inspection        FabricInspection?
  warehouseReceipts WarehouseReceipt[]
  fabricRolls       FabricRoll[]

  @@index([tenantId])
  @@index([grnId])
  @@index([tenantId, status])
}

// ── Fabric Inspection (4-point system) ────────────────────────────────────

model FabricInspection {
  id             String             @id @default(uuid())
  tenantId       String
  number         String
  grnRollId      String             @unique
  inspectorId    String?
  inspectionDate DateTime           @default(now())
  decision       InspectionDecision
  totalPoints    Int                @default(0)
  pointsPer100m  Decimal?           @db.Decimal(6, 2)
  qualityScore   Decimal            @default(0) @db.Decimal(5, 2)
  remarks        String?
  createdOn      DateTime           @default(now())
  createdBy      String?
  updatedOn      DateTime           @updatedAt
  updatedBy      String?
  deletedOn      DateTime?
  deletedBy      String?
  isDeleted      Boolean            @default(false)
  version        Int                @default(0)

  tenant   Tenant                  @relation(fields: [tenantId], references: [id])
  grnRoll  GrnRoll                 @relation(fields: [grnRollId], references: [id])
  inspector User?                  @relation("FabricInspector", fields: [inspectorId], references: [id])
  defects  FabricInspectionDefect[]

  @@unique([tenantId, number])
  @@index([tenantId])
}

model FabricInspectionDefect {
  id           String   @id @default(uuid())
  tenantId     String
  inspectionId String
  defectName   String
  // Verified 4-point scoring inputs: when `points` is not supplied by the
  // inspector it is derived from the defect SIZE along the fabric (≤3" → 1,
  // ≤6" → 2, ≤9" → 3, else 4) and holes/openings always score 4.
  sizeCm       Decimal? @db.Decimal(10, 2) // defect length along the fabric (base cm)
  defectType   DefectType @default(OTHER)
  points       Int // 1–4 per the 4-point inspection system
  notes        String?
  createdOn    DateTime @default(now())

  tenant     Tenant           @relation(fields: [tenantId], references: [id])
  inspection FabricInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([inspectionId])
}

// ── Warehouse Receipt (approved rolls → stock) ────────────────────────────

model WarehouseReceipt {
  id          String   @id @default(uuid())
  tenantId    String
  number      String
  grnRollId   String   @unique
  warehouseId String
  rack        String?
  shelf       String?
  bin         String?
  receivedOn  DateTime @default(now())
  createdOn   DateTime @default(now())
  createdBy   String?
  updatedOn   DateTime @updatedAt
  updatedBy   String?
  deletedOn   DateTime?
  deletedBy   String?
  isDeleted   Boolean  @default(false)
  version     Int      @default(0)

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  grnRoll   GrnRoll   @relation(fields: [grnRollId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  @@unique([tenantId, number])
  @@index([tenantId])
  @@index([tenantId, grnRollId])
}

// ── Stock transactions (minimal Phase 2 hand-off — full Inventory is Phase 3) ──

model StockTransaction {
  id              String              @id @default(uuid())
  tenantId        String
  number          String?
  transactionType StockTransactionType @default(IN)
  warehouseId     String
  itemName        String
  quantity        Decimal             @db.Decimal(12, 3)
  unit            Unit                @default(METERS)
  batch           String?
  lot             String?
  rack            String?
  shelf           String?
  bin             String?
  unitCost        Decimal?            @db.Decimal(14, 2)
  refEntityType   String?
  refEntityId     String?
  createdOn       DateTime            @default(now())
  createdBy       String?

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  @@index([tenantId, warehouseId, createdOn])
  @@index([tenantId, itemName])
}

// ══════════════════════════════════════════════════════════════════════════
// PHASE 3 — CUTTING ROOM
//
// Fabric measurement, roll visualization, marker planning, lay planning and
// actual consumption tracking.
//
// Material model: a FabricRoll is a CONTINUOUS source of fabric. Cutting
// never splits the physical roll — it writes transactions (RollTransaction)
// and logical spans (FabricSegment) against it. Remaining length is always
// derived from the ledger, never overwritten.
//
// Units: all lengths/areas are stored in the base unit CENTIMETERS (cm) and
// SQUARE CENTIMETERS. The UI converts to the user's display unit only at
// render time — calculations never run on display strings.
//
// Estimated vs Planned vs Actual: planning numbers (marker efficiency, lay
// output) are stored on Marker/LayPlan as `*Planned`; real results are
// recorded on CutOperation as `*Actual`. They are never mixed.
// ══════════════════════════════════════════════════════════════════════════

model FabricRoll {
  id              String           @id @default(uuid())
  tenantId        String
  number          String // e.g. R-00125 (per-tenant sequence)
  // ── identity ──
  fabricId        String? // link to the Fabric master (optional; free-text identity still supported)
  grnRollId       String? // link to procurement when the roll arrived via GRN
  fabricName      String?
  fabricType      String?
  color           String?
  shadeLot        String?
  supplierRef     String?
  gsm             Decimal?         @db.Decimal(6, 2)
  // ── measurements (base unit: cm; UI converts for display) ──
  originalLengthCm Decimal         @default(0) @db.Decimal(12, 2)
  remainingLengthCm Decimal       @default(0) @db.Decimal(12, 2) // ledger-derived, maintained by the service layer
  widthCm         Decimal          @default(0) @db.Decimal(8, 2) // nominal width
  usableWidthCm   Decimal          @default(0) @db.Decimal(8, 2) // confirmed usable width (inside selvedge)
  weightKg        Decimal?         @db.Decimal(12, 3)
  lengthUnit      LengthUnit       @default(METERS) // display preference for this roll
  widthUnit       LengthUnit       @default(INCHES) // display preference for widths
  // ── multi-point width measurement summary ──
  minWidthCm      Decimal?
  maxWidthCm      Decimal?
  avgWidthCm      Decimal?
  measurementNote String?
  // ── lifecycle ──
  status          FabricRollStatus @default(DRAFT)
  cutQtyPlanned   Int              @default(0) // garments planned across lays (planned view)
  cutQtyActual    Int              @default(0) // garments actually cut (actual view)
  notes           String?
  createdOn       DateTime         @default(now())
  createdBy       String?
  updatedOn       DateTime         @updatedAt
  updatedBy       String?
  deletedOn       DateTime?
  deletedBy       String?
  isDeleted       Boolean          @default(false)
  version         Int              @default(0)

  tenant        Tenant            @relation(fields: [tenantId], references: [id])
  fabric        Fabric?           @relation(fields: [fabricId], references: [id])
  grnRoll       GrnRoll?          @relation(fields: [grnRollId], references: [id])
  remnants      Remnant[]
  measurements  FabricMeasurement[]
  segments      FabricSegment[]
  defects       FabricDefect[]
  transactions  RollTransaction[]
  layPlans      LayPlan[]
  cutOperations CutOperation[]

  @@unique([tenantId, number])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, fabricId])
}

/// A physically separated leftover of usable fabric, cut away from a roll at
/// close-out. Distinct from "remaining roll" (fabric still attached to the
/// continuous roll) and from waste (no longer usable). Created only by the
/// explicit close-roll/remnant workflow; consumption from a remnant is a
/// documented V1 limitation (the cutting engine sources continuous rolls).
model Remnant {
  id             String   @id @default(uuid())
  tenantId       String
  number         String // RM-0001 (per-tenant sequence)
  sourceRollId   String
  // Where on the parent roll this remnant was cut from (absolute cm).
  sourceStartCm  Decimal  @db.Decimal(12, 2)
  sourceEndCm    Decimal  @db.Decimal(12, 2)
  lengthCm       Decimal  @db.Decimal(12, 2)
  widthCm        Decimal  @db.Decimal(8, 2) // nominal width inherited from the parent roll
  usableWidthCm  Decimal  @db.Decimal(8, 2)
  status         RemnantStatus @default(AVAILABLE)
  location       String?
  // identity snapshot from the parent roll at creation time
  fabricName     String?
  fabricType     String?
  color          String?
  shadeLot       String?
  gsm            Decimal? @db.Decimal(6, 2)
  notes          String?
  createdOn      DateTime @default(now())
  createdBy      String?
  updatedOn      DateTime @updatedAt
  updatedBy      String?
  deletedOn      DateTime?
  deletedBy      String?
  isDeleted      Boolean  @default(false)
  version        Int      @default(0)

  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  sourceRoll FabricRoll @relation(fields: [sourceRollId], references: [id])

  @@unique([tenantId, number])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([sourceRollId])
}
/// Multiple width readings: beginning / middle / end (+ extra points).
model FabricMeasurement {
  id            String     @id @default(uuid())
  tenantId      String
  rollId        String
  measuredOn    DateTime   @default(now())
  measuredBy    String?
  lengthCm      Decimal    @db.Decimal(12, 2)
  beginWidthCm  Decimal?
  middleWidthCm Decimal?
  endWidthCm   Decimal?
  minWidthCm    Decimal?
  maxWidthCm    Decimal?
  avgWidthCm    Decimal?
  usableWidthCm Decimal    @db.Decimal(8, 2) // the operator-confirmed usable width for this session
  note          String?
  createdOn     DateTime   @default(now())
  createdBy     String?

  tenant  Tenant       @relation(fields: [tenantId], references: [id])
  roll    FabricRoll   @relation(fields: [rollId], references: [id], onDelete: Cascade)
  measuredByUser User? @relation("RollMeasurer", fields: [measuredBy], references: [id])

  @@index([tenantId])
  @@index([rollId])
}

/// Logical spans along the roll: AVAILABLE / RESERVED / CONSUMED / DEFECT /
/// WASTE / REMNANT. Positions are absolute cm from roll start. The service
/// layer keeps a clean, non-overlapping partition; every material-moving
/// operation rewrites the affected span(s) transactionally.
model FabricSegment {
  id        String      @id @default(uuid())
  tenantId  String
  rollId    String
  startCm   Decimal     @db.Decimal(12, 2)
  endCm     Decimal     @db.Decimal(12, 2)
  type      SegmentType @default(AVAILABLE)
  refType   String? // e.g. 'lay-plan' | 'marker' | 'defect'
  refId     String?
  label     String?
  createdOn DateTime    @default(now())

  tenant Tenant     @relation(fields: [tenantId], references: [id])
  roll   FabricRoll @relation(fields: [rollId], references: [id], onDelete: Cascade)

  @@index([tenantId, rollId, startCm])
}

/// Physical defect found during inspection. `startCm..endCm` locates it along
/// the roll; `affectedWidthCm` spans the width it ruins (0 = full width).
model FabricDefect {
  id              String         @id @default(uuid())
  tenantId        String
  rollId          String
  code            String? // D-1, D-2 …
  defectType      DefectType     @default(OTHER)
  startCm         Decimal        @db.Decimal(12, 2)
  endCm           Decimal        @db.Decimal(12, 2)
  affectedWidthCm Decimal        @default(0) @db.Decimal(8, 2)
  severity        DefectSeverity @default(MINOR)
  status          DefectStatus   @default(OPEN)
  notes           String?
  photoUrl        String?
  createdOn       DateTime       @default(now())
  createdBy       String?
  updatedOn       DateTime       @updatedAt
  updatedBy       String?
  deletedOn       DateTime?
  deletedBy       String?
  isDeleted       Boolean        @default(false)
  version         Int            @default(0)

  tenant Tenant     @relation(fields: [tenantId], references: [id])
  roll   FabricRoll @relation(fields: [rollId], references: [id], onDelete: Cascade)

  @@index([tenantId, rollId, startCm])
}

/// Append-only material ledger. `quantityCm` is signed: negative = removed
/// from the roll, positive = returned. Remaining length = original − Σ|out|
/// and is NEVER silently overwritten — corrections are new rows.
model RollTransaction {
  id          String              @id @default(uuid())
  tenantId    String
  rollId      String
  type        RollTransactionType
  quantityCm  Decimal             @db.Decimal(12, 2) // signed
  balanceAfterCm Decimal          @db.Decimal(12, 2) // roll length after this entry
  refType     String? // 'lay-plan' | 'cut-operation' | 'defect' | 'adjustment'
  refId       String?
  refLabel    String? // human-readable, e.g. "Lay #LP-2026-0001"
  note        String?
  createdOn   DateTime            @default(now())
  createdBy   String?

  tenant Tenant     @relation(fields: [tenantId], references: [id])
  roll   FabricRoll @relation(fields: [rollId], references: [id], onDelete: Cascade)

  @@index([tenantId, rollId, createdOn])
}

/// A reusable style-level pattern set (a “style folder” of pattern pieces).
/// Markers copy pieces from a set; the copies keep their real dimensions.
model PatternSet {
  id          String       @id @default(uuid())
  tenantId    String
  code        String // e.g. SHIRT-001 — unique per tenant per revision label
  name        String
  styleRef    String?
  version     Int          @default(1) // revision label (v1, v2, v3…). A new revision is a NEW row that copies pieces — production patterns are never overwritten in place.
  status      EntityStatus @default(ACTIVE)
  description String?
  supersedesId String? @unique // the PatternSet this revision replaces
  notes       String?
  createdOn   DateTime     @default(now())
  createdBy   String?
  updatedOn   DateTime     @updatedAt
  updatedBy   String?
  deletedOn   DateTime?
  deletedBy   String?
  isDeleted   Boolean      @default(false)

  tenant     Tenant         @relation(fields: [tenantId], references: [id])
  pieces     PatternPiece[]
  markers    Marker[]
  supersedes PatternSet?    @relation("PatternSetRevisions", fields: [supersedesId], references: [id])
  supersededBy PatternSet?  @relation("PatternSetRevisions")

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, styleRef])
}

/// A pattern piece master (per size). Dimensions are real-world, base unit cm.
model PatternPiece {
  id             String        @id @default(uuid())
  tenantId       String
  patternSetId   String
  name           String // Front, Back, Sleeve…
  size           String? // M, L, XL…
  widthCm        Decimal       @db.Decimal(8, 2)
  heightCm       Decimal       @db.Decimal(8, 2)
  quantity       Int           @default(1) // pieces per garment
  grainDirection GrainDirection @default(VERTICAL)
  rotationAllowed Boolean      @default(true)
  mirrored       Boolean       @default(false)
  seamAllowanceCm Decimal      @default(0) @db.Decimal(6, 2)
  notes          String?
  createdOn      DateTime      @default(now())
  createdBy      String?
  updatedOn      DateTime      @updatedAt
  updatedBy      String?

  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  patternSet PatternSet  @relation(fields: [patternSetId], references: [id], onDelete: Cascade)
  markerPieces MarkerPiece[]

  @@index([tenantId, patternSetId])
}

/// The marker: a cutting layout of pattern pieces across the usable width.
/// Efficiency / length are planning values, recomputed from piece geometry.
model Marker {
  id              String       @id @default(uuid())
  tenantId        String
  number          String // MK-2026-0001
  version         Int          @default(1) // revision counter (see MarkerRevision)
  status          MarkerStatus @default(DRAFT)
  patternSetId    String?
  styleRef        String?
  fabricType      String?
  color           String?
  sizeRatioJson   Json // { "M": 2, "L": 2, "XL": 1 }
  // marker geometry — base unit cm
  widthCm         Decimal      @db.Decimal(8, 2) // usable width the marker was designed for
  lengthCm        Decimal      @default(0) @db.Decimal(12, 2) // physical marker length (pieces + end allowance)
  endAllowanceCm  Decimal      @default(0) @db.Decimal(6, 2)
  // planning results (server-computed; never client-supplied)
  patternAreaCm2  Decimal      @default(0) @db.Decimal(14, 2)
  markerAreaCm2   Decimal      @default(0) @db.Decimal(14, 2)
  efficiencyPct   Decimal      @default(0) @db.Decimal(6, 2)
  garmentsPerMarker Int        @default(0)
  notes           String?
  createdOn       DateTime     @default(now())
  createdBy       String?
  updatedOn       DateTime     @updatedAt
  updatedBy       String?
  deletedOn       DateTime?
  deletedBy       String?
  isDeleted       Boolean      @default(false)

  tenant      Tenant          @relation(fields: [tenantId], references: [id])
  patternSet  PatternSet?     @relation(fields: [patternSetId], references: [id])
  pieces      MarkerPiece[]
  revisions   MarkerRevision[]
  layPlans    LayPlan[]

  @@unique([tenantId, number])
  @@index([tenantId])
  @@index([tenantId, status])
}

/// A pattern piece placed inside a marker. x/y/rotation are real geometry in
/// cm relative to the marker origin (top-left). `size` + name identify the
/// garment part; quantity > 1 stamps identical copies.
model MarkerPiece {
  id             String         @id @default(uuid())
  tenantId       String
  markerId       String
  patternPieceId String?
  name           String
  size           String?
  xCm            Decimal        @db.Decimal(10, 2)
  yCm            Decimal        @db.Decimal(10, 2)
  widthCm        Decimal        @db.Decimal(8, 2)
  heightCm       Decimal        @db.Decimal(8, 2)
  rotationDeg    Decimal        @default(0) @db.Decimal(6, 2)
  grainDirection GrainDirection @default(VERTICAL)
  mirrored       Boolean        @default(false)
  color          String? // UI hint (e.g. color by size)

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  marker       Marker        @relation(fields: [markerId], references: [id], onDelete: Cascade)
  patternPiece PatternPiece? @relation(fields: [patternPieceId], references: [id])

  @@index([tenantId, markerId])
}

/// Immutable snapshot of a marker state at finalize/rename time — planning
/// history is never overwritten. See the description of Marker for the
/// live row's own version counter.
model MarkerRevision {
  id             String       @id @default(uuid())
  tenantId       String
  markerId       String
  revisionNumber Int
  snapshot       Json // full marker + pieces snapshot
  note           String?
  createdOn      DateTime     @default(now())
  createdBy      String?

  tenant Tenant @relation(fields: [tenantId], references: [id])
  marker Marker @relation(fields: [markerId], references: [id], onDelete: Cascade)

  @@unique([markerId, revisionNumber])
  @@index([tenantId])
}

/// Cut order: required production quantity per size for a style/color.
model CutOrder {
  id             String          @id @default(uuid())
  tenantId       String
  number         String // CO-2026-0001
  status         CutOrderStatus  @default(DRAFT)
  styleRef       String?
  color          String?
  fabricType     String?
  requiredJson   Json // { "M": 200, "L": 300, "XL": 200 }
  notes          String?
  approvedOn     DateTime?
  approvedBy     String?
  createdOn      DateTime        @default(now())
  createdBy      String?
  updatedOn      DateTime        @updatedAt
  updatedBy      String?
  deletedOn      DateTime?
  deletedBy      String?
  isDeleted      Boolean         @default(false)
  version        Int             @default(0)

  tenant    Tenant       @relation(fields: [tenantId], references: [id])
  layPlans  LayPlan[]

  @@unique([tenantId, number])
  @@index([tenantId])
  @@index([tenantId, status])
}

/// One lay: a marker × ply combination, optionally bound to a cut order and a
/// fabric roll. Planned quantities are the contract; actuals live on CutOperation.
model LayPlan {
  id             String        @id @default(uuid())
  tenantId       String
  number         String // LP-2026-0001
  status         LayPlanStatus @default(PLANNED)
  cutOrderId     String?
  markerId       String
  rollId         String
  ply            Int
  garmentsPerMarker Int        @default(0) // snapshot of marker size ratio at plan time
  markerLengthCm Decimal       @db.Decimal(12, 2) // snapshot
  markerStartCm  Decimal       @default(0) @db.Decimal(12, 2) // where on the roll this lay is placed
  // planned roll-up (from marker + ply) — planning view
  theoreticalPieces Int        @default(0)
  fabricPlannedCm  Decimal     @default(0) @db.Decimal(12, 2) // = markerLengthCm (single ply)
  notes          String?
  createdOn      DateTime      @default(now())
  createdBy      String?
  updatedOn      DateTime      @updatedAt
  updatedBy      String?

  tenant     Tenant        @relation(fields: [tenantId], references: [id])
  cutOrder   CutOrder?     @relation(fields: [cutOrderId], references: [id])
  marker     Marker        @relation(fields: [markerId], references: [id])
  roll       FabricRoll    @relation(fields: [rollId], references: [id])
  cutOperations CutOperation[]

  @@unique([tenantId, number])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([rollId])
}

/// Actual cutting result for a lay. Recording completion writes the CONSUMED
/// transaction + CONSUMED segment to the roll ledger and bumps remaining
/// fabric. Actuals are recorded once (completed operations are locked).
model CutOperation {
  id              String            @id @default(uuid())
  tenantId        String
  number          String // CT-2026-0001
  layPlanId       String
  rollId          String
  performedOn     DateTime          @default(now())
  status          CutOperationStatus @default(PENDING)
  // actual results (never copied from planning)
  actualLengthCm  Decimal?          @db.Decimal(12, 2) // fabric actually consumed from the roll
  actualPieces    Int? // garment sets actually cut
  rejectedPieces  Int? // rejects during/after cutting
  wasteLengthCm   Decimal?          @db.Decimal(12, 2) // end loss / miscut unusable fabric
  markerStartCm   Decimal?          @db.Decimal(12, 2)
  markerEndCm     Decimal?          @db.Decimal(12, 2)
  notes           String?
  createdOn       DateTime          @default(now())
  createdBy       String?
  updatedOn       DateTime          @updatedAt
  updatedBy       String?

  tenant  Tenant     @relation(fields: [tenantId], references: [id])
  layPlan LayPlan    @relation(fields: [layPlanId], references: [id], onDelete: Cascade)
  roll    FabricRoll @relation(fields: [rollId], references: [id])

  @@unique([tenantId, number])
  @@index([tenantId])
  @@index([layPlanId])
}

model Fabric {
  id           String       @id @default(uuid())
  tenantId     String
  code         String // e.g. CT-TWILL-01
  name         String // e.g. Cotton Twill
  fabricType   String? // Woven / Knit…
  composition  String? // e.g. 100% Cotton
  gsm          Decimal?     @db.Decimal(6, 2)
  defaultWidthCm Decimal?   @db.Decimal(8, 2) // default nominal width (base cm)
  defaultWidthUnit LengthUnit @default(INCHES) // display unit for the default width
  description  String?
  status       EntityStatus @default(ACTIVE)
  createdOn    DateTime     @default(now())
  createdBy    String?
  updatedOn    DateTime     @updatedAt
  updatedBy    String?
  deletedOn    DateTime?
  deletedBy    String?
  isDeleted    Boolean      @default(false)
  version      Int          @default(0)

  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  rolls      FabricRoll[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

